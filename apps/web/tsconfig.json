{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/browser/**/*.ts",
    "tests/browser/**/*.tsx",
    "vite.config.ts",
    "vite.browser.config.ts",
    "playwright.config.ts"
  ]
}
