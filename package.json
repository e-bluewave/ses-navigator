{
  "name": "ses-navigator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "client:generate": "node scripts/generate-api-client.mjs",
    "client:check": "node scripts/generate-api-client.mjs --check",
    "cli:entry:check": "node --test scripts/cli-entry.test.mjs",
    "contract:check": "node scripts/check-openapi.mjs",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "lint": "eslint .",
    "security:data-api": "node scripts/data-api-security-regression.mjs",
    "security:data-api:check": "node --test scripts/data-api-security-regression.test.mjs",
    "security:data-api-writes": "node scripts/check-data-api-write-surface.mjs",
    "security:data-api-writes:check": "node --test scripts/check-data-api-write-surface.test.mjs",
    "security:data-api-rpcs": "node scripts/check-data-api-rpc-surface.mjs",
    "security:data-api-rpcs:check": "node --test scripts/check-data-api-rpc-surface.test.mjs",
    "security:data-api-routing": "node scripts/check-data-api-schema-routing.mjs",
    "security:data-api-routing:check": "node --test scripts/check-data-api-schema-routing.test.mjs",
    "security:data-api-runtime": "node scripts/data-api-runtime-boundary-regression.mjs",
    "security:data-api-runtime:check": "node --test scripts/data-api-runtime-boundary-regression.test.mjs",
    "security:data-api-sensitive": "node scripts/check-sensitive-data-api-surface.mjs",
    "security:data-api-sensitive:check": "node --test scripts/check-sensitive-data-api-surface.test.mjs",
    "security:data-api:all": "node scripts/data-api-security-suite.mjs",
    "security:data-api:all:check": "node --test scripts/data-api-security-suite.test.mjs",
    "security:client-secrets": "node scripts/check-client-secret-boundary.mjs",
    "security:client-secrets:check": "node --test scripts/check-client-secret-boundary.test.mjs",
    "security:db-connectivity": "node scripts/check-database-connectivity-policy.mjs",
    "security:db-connectivity:check": "node --test scripts/check-database-connectivity-policy.test.mjs",
    "security:env-separation": "node scripts/check-environment-separation.mjs",
    "security:env-separation:check": "node --test scripts/check-environment-separation.test.mjs",
    "security:secret-inventory": "node scripts/check-secret-inventory.mjs",
    "security:secret-inventory:check": "node --test scripts/check-secret-inventory.test.mjs",
    "security:service-rpc": "node scripts/service-role-rpc-security-regression.mjs",
    "security:service-rpc:check": "node --test scripts/service-role-rpc-security-regression.test.mjs",
    "security:supabase-config": "node scripts/check-supabase-config.mjs",
    "security:supabase-config:check": "node --test scripts/check-supabase-config.test.mjs",
    "smoke:auth-project": "node scripts/auth-project-smoke.mjs",
    "smoke:auth-project:check": "node --test scripts/auth-project-smoke.test.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
