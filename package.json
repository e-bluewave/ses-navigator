{
  "name": "ses-navigator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "client:generate": "node scripts/generate-api-client.mjs",
    "client:check": "node scripts/generate-api-client.mjs --check",
    "contract:check": "node scripts/check-openapi.mjs",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "lint": "eslint .",
    "security:data-api": "node scripts/data-api-security-regression.mjs",
    "security:data-api:check": "node --test scripts/data-api-security-regression.test.mjs",
    "security:data-api-writes": "node scripts/check-data-api-write-surface.mjs",
    "security:data-api-writes:check": "node --test scripts/check-data-api-write-surface.test.mjs",
    "security:service-rpc": "node scripts/service-role-rpc-security-regression.mjs",
    "security:service-rpc:check": "node --test scripts/service-role-rpc-security-regression.test.mjs",
    "security:supabase-config": "node scripts/check-supabase-config.mjs",
    "security:supabase-config:check": "node --test scripts/check-supabase-config.test.mjs",
    "smoke:auth-project": "node scripts/auth-project-smoke.mjs",
    "smoke:auth-project:check": "node --test scripts/auth-project-smoke.test.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
