{
  "name": "ses-navigator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "client:generate": "node scripts/generate-api-client.mjs",
    "client:check": "node scripts/generate-api-client.mjs --check",
    "cli:entry:check": "node --test scripts/cli-entry.test.mjs",
    "contract:check": "node scripts/check-openapi.mjs",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,yaml,mjs}\"",
    "lint": "eslint .",
    "release:readiness": "node scripts/check-p0-release-readiness.mjs",
    "release:readiness:check": "node --test scripts/check-p0-release-readiness.test.mjs",
    "release:readiness:require": "node scripts/check-p0-release-readiness.mjs --require-ready",
    "security:data-api": "node scripts/data-api-security-regression.mjs",
    "security:data-api:check": "node --test scripts/data-api-security-regression.test.mjs",
    "security:data-api-writes": "node scripts/check-data-api-write-surface.mjs",
    "security:data-api-writes:check": "node --test scripts/check-data-api-write-surface.test.mjs",
    "security:data-api-rpcs": "node scripts/check-data-api-rpc-surface.mjs",
    "security:data-api-rpcs:check": "node --test scripts/check-data-api-rpc-surface.test.mjs",
    "security:data-api-routing": "node scripts/check-data-api-schema-routing.mjs",
    "security:data-api-routing:check": "node --test scripts/check-data-api-schema-routing.test.mjs",
    "security:data-api-runtime": "node scripts/data-api-runtime-boundary-regression.mjs",
    "security:data-api-runtime:check": "node --test scripts/data-api-runtime-boundary-regression.test.mjs",
    "security:data-api-sensitive": "node scripts/check-sensitive-data-api-surface.mjs",
    "security:data-api-sensitive:check": "node --test scripts/check-sensitive-data-api-surface.test.mjs",
    "security:data-api:all": "node scripts/data-api-security-suite.mjs",
    "security:data-api:all:check": "node --test scripts/data-api-security-suite.test.mjs",
    "security:client-secrets": "node scripts/check-client-secret-boundary.mjs",
    "security:client-secrets:check": "node --test scripts/check-client-secret-boundary.test.mjs",
    "security:data-migration": "node scripts/check-data-migration-policy.mjs",
    "security:data-migration:check": "node --test scripts/check-data-migration-policy.test.mjs",
    "security:db-backup": "node scripts/check-database-backup-policy.mjs",
    "security:db-backup:check": "node --test scripts/check-database-backup-policy.test.mjs",
    "security:db-backup-evidence": "node scripts/check-database-backup-evidence.mjs",
    "security:db-backup-evidence:check": "node --test scripts/check-database-backup-evidence.test.mjs",
    "security:db-connectivity": "node scripts/check-database-connectivity-policy.mjs",
    "security:db-connectivity:check": "node --test scripts/check-database-connectivity-policy.test.mjs",
    "security:region-connectivity-evidence": "node scripts/check-region-connectivity-evidence.mjs",
    "security:region-connectivity-evidence:check": "node --test scripts/check-region-connectivity-evidence.test.mjs",
    "security:env-separation": "node scripts/check-environment-separation.mjs",
    "security:env-separation:check": "node --test scripts/check-environment-separation.test.mjs",
    "security:env-separation-evidence": "node scripts/check-environment-separation-evidence.mjs",
    "security:env-separation-evidence:check": "node --test scripts/check-environment-separation-evidence.test.mjs",
    "security:file-malware-scanning": "node scripts/check-file-malware-scanning-policy.mjs",
    "security:file-malware-scanning:check": "node --test scripts/check-file-malware-scanning-policy.test.mjs",
    "security:finance": "node scripts/check-finance-policy.mjs",
    "security:finance:check": "node --test scripts/check-finance-policy.test.mjs",
    "security:load-test": "node scripts/check-load-test-policy.mjs",
    "security:load-test:check": "node --test scripts/check-load-test-policy.test.mjs",
    "security:long-running-processing": "node scripts/check-long-running-processing-policy.mjs",
    "security:long-running-processing:check": "node --test scripts/check-long-running-processing-policy.test.mjs",
    "security:monitoring": "node scripts/check-monitoring-policy.mjs",
    "security:monitoring:check": "node --test scripts/check-monitoring-policy.test.mjs",
    "security:personal-data-erasure": "node scripts/check-personal-data-erasure-policy.mjs",
    "security:personal-data-erasure:check": "node --test scripts/check-personal-data-erasure-policy.test.mjs",
    "security:restore-drill": "node scripts/check-restore-drill-policy.mjs",
    "security:restore-drill:check": "node --test scripts/check-restore-drill-policy.test.mjs",
    "security:rpo-rto": "node scripts/check-rpo-rto-policy.mjs",
    "security:rpo-rto:check": "node --test scripts/check-rpo-rto-policy.test.mjs",
    "security:retention": "node scripts/check-retention-policy.mjs",
    "security:retention:check": "node --test scripts/check-retention-policy.test.mjs",
    "security:secret-inventory": "node scripts/check-secret-inventory.mjs",
    "security:secret-inventory:check": "node --test scripts/check-secret-inventory.test.mjs",
    "security:secret-rotation-evidence": "node scripts/check-secret-rotation-drill-evidence.mjs",
    "security:secret-rotation-evidence:check": "node --test scripts/check-secret-rotation-drill-evidence.test.mjs",
    "security:service-rpc": "node scripts/service-role-rpc-security-regression.mjs",
    "security:service-rpc:check": "node --test scripts/service-role-rpc-security-regression.test.mjs",
    "security:storage-backup": "node scripts/check-storage-backup-policy.mjs",
    "security:storage-backup:check": "node --test scripts/check-storage-backup-policy.test.mjs",
    "security:storage-backup-evidence": "node scripts/check-storage-backup-evidence.mjs",
    "security:storage-backup-evidence:check": "node --test scripts/check-storage-backup-evidence.test.mjs",
    "security:supabase-config": "node scripts/check-supabase-config.mjs",
    "security:supabase-config:check": "node --test scripts/check-supabase-config.test.mjs",
    "smoke:auth-lifecycle": "node scripts/auth-lifecycle-access-probe.mjs",
    "smoke:auth-lifecycle:check": "node --test scripts/auth-lifecycle-access-probe.test.mjs",
    "smoke:auth-project": "node scripts/auth-project-smoke.mjs",
    "smoke:auth-project:check": "node --test scripts/auth-project-smoke.test.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
